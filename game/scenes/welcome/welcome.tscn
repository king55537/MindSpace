[gd_scene load_steps=4 format=3]

[ext_resource type="Texture2D" path="res://assets/images/menu/menu_bg.png" id="1_bg"]
[ext_resource type="Theme" path="res://themes/pixel_theme.tres" id="2_theme"]
[ext_resource type="Script" path="res://scenes/welcome/welcome.gd" id="3_script"]

[node name="Welcome" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("3_script")

[node name="Background" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("1_bg")
expand_mode = 1
stretch_mode = 0

[node name="Ui" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 64
theme_override_constants/margin_top = 30
theme_override_constants/margin_right = 430
theme_override_constants/margin_bottom = 30

[node name="Column" type="VBoxContainer" parent="Ui"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Ui/Column"]
layout_mode = 2
theme_override_colors/font_color = Color(0.87451, 0.909804, 0.941176, 1)
theme_override_colors/font_shadow_color = Color(0.058824, 0.090196, 0.121569, 1)
theme_override_constants/shadow_offset_x = 4
theme_override_constants/shadow_offset_y = 4
theme_override_font_sizes/font_size = 40
text = "MindSpace"

[node name="Subtitle" type="Label" parent="Ui/Column"]
layout_mode = 2
theme_override_colors/font_color = Color(0.290196, 0.658824, 0.705882, 1)
theme_override_colors/font_shadow_color = Color(0.058824, 0.090196, 0.121569, 1)
theme_override_constants/shadow_offset_x = 2
theme_override_constants/shadow_offset_y = 2
text = "Junior Astronaut Mission Trainer"

[node name="Spacer" type="Control" parent="Ui/Column"]
layout_mode = 2
size_flags_vertical = 3

[node name="ContinueButton" type="Button" parent="Ui/Column"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(272, 56)
layout_mode = 2
size_flags_horizontal = 0
text = "Continue"

[node name="PlayButton" type="Button" parent="Ui/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(272, 56)
layout_mode = 2
size_flags_horizontal = 0
text = "Start game"

[node name="OptionsButton" type="Button" parent="Ui/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(272, 56)
layout_mode = 2
size_flags_horizontal = 0
text = "Settings"

[node name="Toast" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -42.0
offset_bottom = -14.0
grow_horizontal = 2
grow_vertical = 0
theme_override_colors/font_color = Color(1, 0.886275, 0.478431, 1)
theme_override_colors/font_shadow_color = Color(0.058824, 0.090196, 0.121569, 1)
theme_override_constants/shadow_offset_x = 2
theme_override_constants/shadow_offset_y = 2
horizontal_alignment = 1

[connection signal="pressed" from="Ui/Column/ContinueButton" to="." method="_on_continue_pressed"]
[connection signal="pressed" from="Ui/Column/PlayButton" to="." method="_on_play_pressed"]
[connection signal="pressed" from="Ui/Column/OptionsButton" to="." method="_on_options_pressed"]
